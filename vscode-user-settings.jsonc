{
  "files.insertFinalNewline": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.prettier": "explicit",
    "source.organizeImports": "explicit",
  },
  "black-formatter.args": ["--line-length", "119"],
  "isort.args": ["--profile", "black", "--line-length", "119"],
  "flake8.args": ["--extend-ignore", "E203", "--max-line-length", "119"],
  "code-runner.runInTerminal": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
  },

  // =============================================================================
  // 1. 基本設定 (General Settings)
  // =============================================================================
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "editor.lineNumbers": "relative",
  "vim.leader": "<space>",

  // =============================================================================
  // 2. ノーマルモード設定 (Normal Mode Keybindings)
  // =============================================================================
  "vim.normalModeKeyBindingsNonRecursive": [
    // [ページ移動 / 行内移動 / カッコ移動]
    { "before": ["J"], "after": ["<C-d>"] },
    { "before": ["K"], "after": ["<C-u>"] },
    { "before": ["L"], "after": ["$"] },
    { "before": ["H"], "after": ["^"] },
    { "before": ["M"], "after": ["%"] },

    // [レジスタを汚さない消去・カット]
    { "before": ["d"], "after": ["\"", "_", "d"] },
    { "before": ["d", "d"], "after": ["\"", "_", "d", "d"] },
    { "before": ["D"], "after": ["\"", "_", "D"] },
    { "before": ["x"], "after": ["\"", "_", "x"] },
    { "before": ["c"], "after": ["\"", "_", "c"] },
    { "before": ["c", "c"], "after": ["\"", "_", "c", "c"] },
    { "before": ["C"], "after": ["\"", "_", "C"] },
    { "before": ["s"], "after": ["d"] },
    { "before": ["s", "s"], "after": ["d", "d"] },
    { "before": ["S"], "after": ["D"] },

    // [コード整形] ファイル全体の自動フォーマット (VSCodeネイティブ)
    {
      "before": ["<Leader>", "f"],
      "commands": ["editor.action.formatDocument"],
    },

    // [EasyMotion] 拡張モーション
    { "before": ["m"], "after": ["leader", "leader", "leader", "b", "d", "w"] },

    // [その他の操作] エディタを閉じる / ファイル保存 / 検索ハイライト消去
    {
      "before": ["<Leader>", "w"],
      "commands": ["workbench.action.closeActiveEditor"],
    },
    {
      "before": ["<Leader>", "s"],
      "commands": ["workbench.action.files.save"],
    },
    {
      "before": ["<Leader>", "x"],
      "commands": [
        "workbench.action.files.save",
        "workbench.action.closeActiveEditor",
      ],
    },
    { "before": ["<Leader>", "z"], "commands": [":noh"] },

    // ノーマルモード専用設定 --------------------------------------------------------------

    // [undo/redo] 大文字 U でリドゥ
    { "before": ["u"], "commands": ["undo"] },
    { "before": ["U"], "commands": ["redo"] },

    // [改行] Enterで直下に空行を挿入してノーマルモードを維持
    { "before": ["<Enter>"], "commands": ["editor.action.insertLineAfter"] },

    // [改行をなくす] Ctrl + j で下の行を連結
    { "before": ["<C-j>"], "after": ["J"] },
  ],

  // =============================================================================
  // 3. インサートモード設定 (Insert Mode Keybindings)
  // =============================================================================
  "vim.insertModeKeyBindingsNonRecursive": [
    // jk でノーマルモードに戻る
    { "before": ["j", "k"], "after": ["<Esc>"] },
    // ;; で補完を起動
    { "before": [";", ";"], "commands": ["editor.action.triggerSuggest"] },
  ],

  // =============================================================================
  // 4. ビジュアルモード設定 (Visual Mode Keybindings)
  // =============================================================================
  "vim.visualModeKeyBindingsNonRecursive": [
    // [ページ移動 / 行内移動 / カッコ移動]
    { "before": ["J"], "after": ["<C-d>"] },
    { "before": ["K"], "after": ["<C-u>"] },
    { "before": ["L"], "after": ["$"] },
    { "before": ["H"], "after": ["^"] },
    { "before": ["M"], "after": ["%"] },

    // [レジスタを汚さない消去・カット]
    { "before": ["d"], "after": ["\"", "_", "d"] },
    { "before": ["D"], "after": ["\"", "_", "D"] },
    { "before": ["x"], "after": ["\"", "_", "x"] },
    { "before": ["c"], "after": ["\"", "_", "c"] },
    { "before": ["C"], "after": ["\"", "_", "C"] },
    { "before": ["s"], "after": ["d"] },
    { "before": ["S"], "after": ["D"] },

    // [コメントアウト] 選択範囲のコメント切り替え
    { "before": ["<Leader>", "c"], "commands": ["editor.action.commentLine"] },

    // [インデント] インデント調整（選択状態の維持はVSCodeVimが標準で対応）
    { "before": [">"], "commands": ["editor.action.indentLines"] },
    { "before": ["<"], "commands": ["editor.action.outdentLines"] },

    // [コード整形] 選択範囲のフォーマット
    {
      "before": ["<Leader>", "f"],
      "commands": ["editor.action.formatSelection"],
    },

    // [EasyMotion] 拡張モーション
    { "before": ["m"], "after": ["leader", "leader", "leader", "b", "d", "w"] },

    // [その他の操作] エディタを閉じる / ファイル保存 / 検索ハイライト消去
    {
      "before": ["<Leader>", "w"],
      "commands": ["workbench.action.closeActiveEditor"],
    },
    {
      "before": ["<Leader>", "s"],
      "commands": ["workbench.action.files.save"],
    },
    {
      "before": ["<Leader>", "x"],
      "commands": [
        "workbench.action.files.save",
        "workbench.action.closeActiveEditor",
      ],
    },
    { "before": ["<Leader>", "z"], "commands": [":noh"] },

    // ビジュアルモード専用設定 ------------------------------------------------------------

    // <Leader>j でノーマルモードに戻る
    { "before": ["<leader>", "j"], "after": ["<Esc>"] },

    // [ペーストでレジスタを汚さない]
    { "before": ["p"], "after": ["\"", "_", "d", "P"] },
  ],

  "vim.operatorPendingModeKeyBindingsNonRecursive": [
    // [ページ移動 / 行内移動 / カッコ移動]
    { "before": ["J"], "after": ["<C-d>"] },
    { "before": ["K"], "after": ["<C-u>"] },
    { "before": ["L"], "after": ["$"] },
    { "before": ["H"], "after": ["^"] },
    { "before": ["M"], "after": ["%"] },
  ],

  // =============================================================================
  // 5. プラグイン・追加機能設定 (Plugin & Features)
  // =============================================================================
  "vim.surround": true,
  "vim.targets.enable": true,
  "vim.easymotion": true,
  "vim.visualstar": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.color": "rgba(100, 170, 240, 0.5)",
  "vim.highlightedyank.duration": 150,
  "vim.handleKeys": {
    "<C-c>": false,
    "<C-v>": false,
    "<C-x>": false,
    "<C-f>": false,
    "<C-a>": false,
    "<C-p>": false,
  },
}
